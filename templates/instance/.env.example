# Copy to .env (gitignored). Empty values are fine for a first local run: the app starts,
# is healthy, and refuses webhooks until the Meta values are set (docs/bring-up.md in meydan).

POSTGRES_PASSWORD=app
SITE_ADDRESS=localhost
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Meta: app secret (signs webhooks), our own handshake token, a system user token, the account.
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# When a model answers (add the `llm` extra). Locally leave the key empty and load it from your
# secret store (e.g. mise + Keychain); on the VM set it here.
OPENROUTER_API_KEY=
MEYDAN_LLM_MODEL=openrouter:deepseek/deepseek-v4.1-flash
